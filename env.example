# Copy to .env.local (gitignored). Never commit real keys.
# Used only by: npm run ai-explain, npm run ask-cache, and the /api/ask route (Claude tool-use agent).
# Without a key the app still works: flag cards show the engine's own text and Ask uses the engine-only router.
ANTHROPIC_API_KEY=
# Optional model override (default claude-sonnet-5)
ANTHROPIC_MODEL=
