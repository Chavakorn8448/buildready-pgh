{
  "name": "buildathon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "score": "tsx scripts/score.ts",
    "test": "vitest run",
    "fetch": "tsx scripts/fetch.ts",
    "preprocess": "node --max-old-space-size=8192 --import tsx scripts/preprocess.ts",
    "reform-impact": "tsx scripts/reform-impact.ts",
    "typecheck": "tsc --noEmit -p tsconfig.engine.json",
    "check-pii": "tsx scripts/check-pii.ts",
    "precompute": "tsx scripts/precompute.ts",
    "build-layers": "tsx scripts/build-display-layers.ts",
    "ai-explain": "tsx scripts/ai-explain.ts",
    "ask-cache": "tsx scripts/ask-cache.ts",
    "sync-maplibre": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
    "prebuild": "npm run -s sync-maplibre",
    "build-adjacency": "node --max-old-space-size=8192 --import tsx scripts/build-adjacency.ts",
    "build-parcel-zip": "tsx scripts/build-parcel-zip.ts",
    "build-permit-reference": "tsx scripts/build-permit-reference.ts"
  },
  "dependencies": {
    "@turf/turf": "^7.4.0",
    "maplibre-gl": "^6.11.2",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
